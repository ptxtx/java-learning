//插入线程
public class ThreadDemo8 {
    public static void main(String[] args) throws InterruptedException {
        //插入线程
        MyThread myThread = new MyThread("土豆");
        myThread.start();

        myThread.join();//表示把myThread这个线程插入到当前线程之前

        for(int i=0;i<10;i++){
            System.out.println("main线程"+i);
        }

    }
}
