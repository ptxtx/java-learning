//Thread的第二种实现方式
package MyThread;

public class ThreadDemo2 {
    public static void main(String[] args) {
        /*
        多线程的第二种启动方式
            自己定义一个类实现Runnable接口
            重写里面的run方法
            创建自己的类的对象
            创建一个Thread类的对象，并开启线程
         */
        MyRun mr=new MyRun();//创建MyRun的对象，表示多线程要执行的任务
        Thread t1=new Thread(mr);//这个线程执行mr
        Thread t2=new Thread(mr);
        //第一个和第二个线程执行的任务都是mr

        t1.setName("线程1");
        t2.setName("线程2");
        t1.start();
        t2.start();

    }
}

public class MyRun implements Runnable{
    @Override
    public void run() {
        for(int i=0;i<100;i++){
            Thread thread = Thread.currentThread();//获取当前线程的对象
            System.out.println(thread.getName()+"HelloWorld");
        }
    }

    //getName方法是在Thread类中的


}
