//用lock代替synchronized
package MyThread;

import java.util.concurrent.locks.Lock;
import java.util.concurrent.locks.ReentrantLock;

public class MyThread4 extends Thread {

    static int ticket=0;//表示共享ticket
    static Lock lock=new ReentrantLock();

   // static Object obj=new Object();//锁对象，一定要是唯一的
    @Override
    public void run() {
        while (true) {
            //同步代码块
          //synchronized (MyThread4.class) {//以该类的字节码文件作为锁对象
            lock.lock();
            try {
               if(ticket<100){
                   ticket++;
                   System.out.println(getName()+"正在卖第"+ticket+"张票");
               }else{
                   break;
               }

                   Thread.sleep(10);
               } catch (InterruptedException e) {
                   throw new RuntimeException(e);
               }finally {
                lock.unlock();
            }

           //}
        }
    }
}
