//Thread的第一种实现方式
public class ThreadDemo1 {
    public static void main(String[] args) {
        /*
        多线程的第一种启动方式
            自己定一个类 继承Thread
            重写run方法
            创建子类对象并启动线程

         */
        MyThread t1 = new MyThread();
        MyThread t2 = new MyThread();

        t1.setName("线程1");
        t2.setName("线程2");
        //启动线程
        t1.start();
        t2.start();

    }
}
public class MyThread extends Thread {
    @Override
    public void run() {
        //书写线程要执行的代码
        for(int i=0;i<100;i++){
            System.out.println(getName()+"HelloWorld");
        }
    }
}
